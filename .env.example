# Copy to .env and fill in. .env is gitignored — never commit real values.
# Only public, synthetic or approved data may be sent to these services (see CLAUDE.md).

# --- App ---
# local | ci | demo
APP_ENV=local
LOG_LEVEL=INFO

# --- Microsoft Foundry: model deployment ---
# Resource name of your Foundry (Azure AI Services) resource, e.g. "group8-foundry"
FOUNDRY_RESOURCE=
FOUNDRY_API_KEY=
# Name of the model deployment you created in the Foundry portal
FOUNDRY_MODEL_DEPLOYMENT=claude-opus-5-5
# Foundry project endpoint (used for evaluations / tracing), from the project overview page
FOUNDRY_PROJECT_ENDPOINT=

# --- Azure AI Search (RAG with citations) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=supplychain-policies

# --- Azure AI Content Safety (content filters + Prompt Shields) ---
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_API_KEY=

# --- Observability (Application Insights) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Tests ---
# set to 1 to run tests marked "integration" against live resources
RUN_INTEGRATION=0
